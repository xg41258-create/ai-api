{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "自动启动后端",
            "type": "shell",
            "command": ".\\venv\\Scripts\\activate && uvicorn main:app --reload",
            "options": {
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}